{
  "name": "11-records-studio-desktop",
  "version": "0.12.4",
  "private": true,
  "description": "Estudio local para crear, revisar y publicar videos de 11 Récords",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --dir",
    "prestart": "node scripts/ensure-deps.cjs",
    "studio": "node scripts/studio.cjs",
    "test:desktop": "node tests/studio-desktop.cjs",
    "test:direct": "node tests/direct-desktop.cjs",
    "test:shorts": "node tests/shorts-browser.cjs",
    "pages": "node scripts/build-pages.cjs",
    "predist:win": "python scripts/build-animation.py"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.13.0",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.53.2"
  },
  "build": {
    "appId": "com.records11.studio",
    "productName": "11 Récords Studio",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/pdfjs-dist/**"
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**",
      "grabador/**",
      "backend/**",
      "legacy/**",
      "assets/**",
      "package.json",
      "node_modules/**",
      "scripts/studio.cjs"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "11-Records-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "jeffer91",
      "repo": "videoslistodoble",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "build/animation/records-animation",
        "to": "animation"
      },
      {
        "from": "browser-stats",
        "to": "browser-stats",
        "filter": [
          "*.js",
          "*.py"
        ]
      },
      {
        "from": "scripts/source-python.ps1",
        "to": "scripts/source-python.ps1"
      }
    ]
  }
}
